NODE_ENV=development
PORT=5000

# Canvas LMS API — see https://instructure.github.io/
# Base URL is your institution's Canvas instance, e.g. https://aut.instructure.com
CANVAS_BASE_URL=
# Generate under Canvas > Account > Settings > New Access Token (dev/testing only)
CANVAS_ACCESS_TOKEN=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — the client's dev server origin
CLIENT_ORIGIN=http://localhost:5173

